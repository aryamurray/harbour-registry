+# {fmt} 11.2.0, shimmed for Harbour.
+#
+# Compiled mode: two translation units, `src/format.cc` (the formatting engine and its tables) and
+# `src/os.cc` (the POSIX file and error wrappers), against headers under `include/`. Nothing is
+# generated and nothing is per-platform on the POSIX side.
+#
+# `cpp_std = "17"` is a MINIMUM, not a need: fmt 11 builds as C++11. 17 is declared so that
+# a consumer asking for more (the registry test asks for 20) raises the whole graph, fmt included.
+# POSIX only: `supports` lists no MSVC triple, and `os.cc` wraps POSIX file calls.
+
+[package]
+name = "fmt"
+version = "11.2.0"
+description = "A modern formatting library"
+license = "MIT"
+homepage = "https://fmt.dev"
+requires = "hosted"
+supports = ["*-apple-darwin", "*-*-linux-gnu", "*-*-linux-musl"]
+
+[targets.fmt]
+kind = "staticlib"
+lang = "c++"
+cpp_std = "17"
+sources = ["src/format.cc", "src/os.cc"]
+public_headers = ["include/fmt/*.h"]
+
+# Headers live under include/fmt/; consumers write `#include <fmt/format.h>`.
+[targets.fmt.public]
+include_dirs = ["include"]
