diff --git a/Harbour.toml b/Harbour.toml
new file mode 100644
index 0000000..cefcc4e
--- /dev/null
+++ b/Harbour.toml
@@ -0,0 +1,99 @@
+[package]
+name = "freetype"
+version = "2.15.0"
+license = "FTL OR GPL-2.0-or-later"
+
+[dependencies]
+zlib = "^1.3"
+libpng = "^1.6"
+harfbuzz = { version = "^15", optional = true }
+
+[features]
+default = []
+
+[targets.freetype]
+kind = "staticlib"
+lang = "c"
+sources = [
+    "src/base/ftinit.c",
+    "src/base/ftbase.c",
+    "src/base/ftbbox.c",
+    "src/base/ftglyph.c",
+    "src/base/ftbdf.c",
+    "src/base/ftbitmap.c",
+    "src/base/ftcid.c",
+    "src/base/ftfstype.c",
+    "src/base/ftgasp.c",
+    "src/base/ftgxval.c",
+    "src/base/ftmm.c",
+    "src/base/ftotval.c",
+    "src/base/ftpatent.c",
+    "src/base/ftpfr.c",
+    "src/base/ftstroke.c",
+    "src/base/ftsynth.c",
+    "src/base/fttype1.c",
+    "src/base/ftwinfnt.c",
+    "src/bdf/bdf.c",
+    "src/cff/cff.c",
+    "src/cid/type1cid.c",
+    "src/pcf/pcf.c",
+    "src/pfr/pfr.c",
+    "src/sfnt/sfnt.c",
+    "src/truetype/truetype.c",
+    "src/type1/type1.c",
+    "src/type42/type42.c",
+    "src/winfonts/winfnt.c",
+    "src/psaux/psaux.c",
+    "src/pshinter/pshinter.c",
+    "src/psnames/psmodule.c",
+    "src/smooth/smooth.c",
+    "src/raster/raster.c",
+    "src/sdf/sdf.c",
+    "src/svg/svg.c",
+    "src/autofit/autofit.c",
+    "src/cache/ftcache.c",
+    "src/gzip/ftgzip.c",
+    "src/lzw/ftlzw.c",
+]
+
+[targets.freetype.surface.compile.private]
+include_dirs = ["."]
+defines = ["FT2_BUILD_LIBRARY"]
+
+# ftoption.h ships these three options commented out, so a define is enough
+# to switch each on. They are public because the header that reads them is.
+[targets.freetype.surface.compile.public]
+include_dirs = ["include"]
+defines = ["FT_CONFIG_OPTION_SYSTEM_ZLIB", "FT_CONFIG_OPTION_USE_PNG"]
+
+[[targets.freetype.surface.when]]
+feature = "harfbuzz"
+[targets.freetype.surface.when."compile.public"]
+defines = ["FT_CONFIG_OPTION_USE_HARFBUZZ"]
+
+# ftsystem.c and ftdebug.c are the two files upstream picks per platform: CMakeLists.txt
+# compiles builds/windows/ftsystem.c and builds/windows/ftdebug.c on WIN32 (memory-mapped
+# files through CreateFileMapping, debug output through OutputDebugString) and, off Windows,
+# src/base/ftdebug.c with a ftsystem.c this manifest has always taken from src/base (the
+# portable stdio one; upstream's CMake takes builds/unix/ftsystem.c on UNIX, which needs a
+# generated ftconfig.h). Linux and macOS keep the files they had. src/base/ftver.rc, which
+# upstream adds on WIN32, is a resource script for a DLL's version block and is not compiled
+# into a static library here.
+[[targets.freetype.when]]
+os = "linux"
+sources = ["src/base/ftsystem.c", "src/base/ftdebug.c"]
+
+[[targets.freetype.when]]
+os = "macos"
+sources = ["src/base/ftsystem.c", "src/base/ftdebug.c"]
+
+# `_CRT_SECURE_NO_WARNINGS` and `_CRT_NONSTDC_NO_WARNINGS` are what CMakeLists.txt adds for WIN32.
+# DLL_EXPORT is only for a shared library, which this is not.
+#
+# FT_CONFIG_OPTION_USE_PNG (public, above) is on here as on Unix, so libpng is a dependency on
+# Windows too. Upstream's own CMake makes PNG optional (FT_DISABLE_PNG); this manifest has no
+# per-platform dependencies, so the choice is the same on every platform.
+[[targets.freetype.when]]
+os = "windows"
+sources = ["builds/windows/ftsystem.c", "builds/windows/ftdebug.c"]
+defines = ["_CRT_SECURE_NO_WARNINGS", "_CRT_NONSTDC_NO_WARNINGS"]
